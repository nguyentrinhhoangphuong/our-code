    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let adultCount = 2;
            let childrenCount = 1;
            let babyCount = 0;
            
            function updatePassengerText() {
                var parts = [];
                
                if (adultCount > 0) {
                    parts.push(adultCount + ' adult' + (adultCount > 1 ? 's' : ''));
                }
                if (childrenCount > 0) {
                    parts.push(childrenCount + ' child' + (childrenCount > 1 ? 'ren' : ''));
                }
                if (babyCount > 0) {
                    parts.push(babyCount + ' baby' + (babyCount > 1 ? 'ies' : ''));
                }
                
                if (parts.length === 0) {
                    parts.push('Select passengers');
                }
                
                document.querySelector('.passenger-text').textContent = parts.join(', ');
                
                // Update hidden inputs
                document.querySelector('input[name="adults"]').value = adultCount;
                document.querySelector('input[name="children"]').value = childrenCount;
                document.querySelector('input[name="babies"]').value = babyCount;
                
                // Update display
                document.getElementById('adult-count').textContent = adultCount;
                document.getElementById('children-count').textContent = childrenCount;
                document.getElementById('baby-count').textContent = babyCount;
                
                // Update minus button states
                updateButtonStates();
            }
            
            function updateButtonStates() {
                document.querySelectorAll('.minus-btn').forEach(function(btn) {
                    var type = btn.getAttribute('data-type');
                    var count = 0;
                    
                    if (type === 'adult') count = adultCount;
                    else if (type === 'children') count = childrenCount;
                    else if (type === 'baby') count = babyCount;
                    
                    btn.disabled = count === 0;
                });
            }
            
            document.querySelectorAll('.plus-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var type = this.getAttribute('data-type');
                    
                    if (type === 'adult') {
                        adultCount++;
                    } else if (type === 'children') {
                        childrenCount++;
                    } else if (type === 'baby') {
                        babyCount++;
                    }
                    
                    updatePassengerText();
                });
            });
            
            document.querySelectorAll('.minus-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var type = this.getAttribute('data-type');
                    
                    if (type === 'adult' && adultCount > 0) {
                        adultCount--;
                    } else if (type === 'children' && childrenCount > 0) {
                        childrenCount--;
                    } else if (type === 'baby' && babyCount > 0) {
                        babyCount--;
                    }
                    
                    updatePassengerText();
                });
            });
            
            updateButtonStates();
            
            document.querySelectorAll('.location-item').forEach(function(item) {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    let value = this.getAttribute('data-value');
                    let text = this.textContent;
                    
                    document.querySelector('.selected-location').textContent = text;
                    document.querySelector('input[name="location"]').value = value;

                    document.querySelectorAll('.location-item').forEach(function(i) {
                        i.classList.remove('active-drop');
                    });
                    this.classList.add('active-drop');
                    
                    UIkit.dropdown(this.closest('.uk-dropdown')).hide();
                });
            });
            
            document.querySelectorAll('.hotel-type-item').forEach(function(item) {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    let value = this.getAttribute('data-value');
                    let text = this.textContent;
                    
                    document.querySelector('.selected-hotel-type').textContent = text;
                    document.querySelector('input[name="hotel_type"]').value = value;

                    document.querySelectorAll('.hotel-type-item').forEach(function(i) {
                        i.classList.remove('active-drop');
                    });
                    this.classList.add('active-drop');
                    
                    UIkit.dropdown(this.closest('.uk-dropdown')).hide();
                });
            });
            
            document.querySelectorAll('.price-item').forEach(function(item) {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    let value = this.getAttribute('data-value');
                    let text = this.textContent;
                    
                    document.querySelector('.selected-price').textContent = text;
                    document.querySelector('input[name="price"]').value = value;

                    document.querySelectorAll('.price-item').forEach(function(i) {
                        i.classList.remove('active-drop');
                    });
                    this.classList.add('active-drop');
                    
                    UIkit.dropdown(this.closest('.uk-dropdown')).hide();
                });
            });
            
            document.querySelectorAll('.sortby-item').forEach(function(item) {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    let value = this.getAttribute('data-value');
                    let text = this.textContent;
                    
                    document.querySelector('.selected-sortby').textContent = text;
                    document.querySelector('input[name="sort_by"]').value = value;

                    document.querySelectorAll('.sortby-item').forEach(function(i) {
                        i.classList.remove('active-drop');
                    });
                    this.classList.add('active-drop');                
                    
                    UIkit.dropdown(this.closest('.uk-dropdown')).hide();
                });
            });

            function handleCheckinChange() {
                const checkin  = document.getElementById('checkin');
                const checkout = document.getElementById('checkout');

                checkin.addEventListener('change', function () {
                    if (!checkin.value) return;

                    const checkinDate = new Date(checkin.value);
                    const checkoutDate = checkout.value ? new Date(checkout.value) : null;

                    // set min checkout = checkin
                    checkout.min = checkin.value;

                    // nếu checkout <= checkin -> +1 ngày
                    if (!checkoutDate || checkoutDate <= checkinDate) {
                        const nextDay = new Date(checkinDate);
                        nextDay.setDate(nextDay.getDate() + 1);
                        checkout.value = nextDay.toISOString().split('T')[0];
                    }
                });
            }
            handleCheckinChange();


            const form = document.querySelector('.hotel-search-form');
            form.addEventListener('reset', function () {
                setTimeout(() => {

                    const today = new Date();
                    const tomorrow = new Date(today);
                    tomorrow.setDate(today.getDate() + 1);

                    const checkin = document.getElementById('checkin');
                    const checkout = document.getElementById('checkout');

                    checkin.value = today.toISOString().split('T')[0];
                    checkout.value = tomorrow.toISOString().split('T')[0];
                    checkout.min = checkin.value;

                    /* ===== PASSENGER ===== */
                    adultCount = 2;
                    childrenCount = 1;
                    babyCount = 0;
                    updatePassengerText();

                    /* ===== LOCATION ===== */
                    document.querySelector('.selected-location').textContent = 'Select';
                    document.querySelector('input[name="location"]').value = '';

                    /* ===== HOTEL TYPE ===== */
                    document.querySelector('.selected-hotel-type').textContent = 'Room Hotel';
                    document.querySelector('input[name="hotel_type"]').value = '';

                    /* ===== PRICE ===== */
                    document.querySelector('.selected-price').textContent = 'From 400,000 VND';
                    document.querySelector('input[name="price"]').value = '';

                    /* ===== SORT ===== */
                    document.querySelector('.selected-sortby').textContent = 'New';
                    document.querySelector('input[name="sort_by"]').value = 'new';

                    /* ===== REMOVE ACTIVE STATE ===== */
                    document.querySelectorAll('.active-drop').forEach(el => {
                        el.classList.remove('active-drop');
                    });

                }, 0);
            });

        });
    </script>
    
    <?php
    return ob_get_clean();
