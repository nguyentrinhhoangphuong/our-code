dành cho grid

/* Column gap */
    .el-element .uk-grid-match[uk-grid] {
        margin-left: -14px !important;
    }
    .el-element .uk-grid-match > div {
        padding-left: 14px !important;
    }
    /* row gap */
    .el-element .uk-grid-margin {
        margin-top: 14px !important;
    }


/* dành cho gap và divider */
.el-element .uk-grid-margin {
    margin-top: 48px !important; // 32px
}

.el-element .uk-grid-divider.uk-grid-stack>.uk-grid-margin::before {
    top: -24px !important;   // -16px
}


/* gap các cột nhung bỏ các cột đầu cuối*/
.uk-grid.uk-grid-column-medium {
    margin-left: 0 !important;
}
.uk-grid.uk-grid-column-medium > * {
    padding-left: 0 !important;
}

.uk-grid.uk-grid-column-medium > *:nth-child(2) {
    padding-left: 34px !important;
}

